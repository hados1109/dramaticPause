{
  "manifest_version": 3,
  "name": "Dramatic Pause for YouTube",
  "short_name": "Dramatic Pause",
  "version": "1.0.5",
  "description": "Pause a YouTube video and time stops: a cinematic ripple or an anime-style freeze plays over the frame.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Dramatic Pause",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
